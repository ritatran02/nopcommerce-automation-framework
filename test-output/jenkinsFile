pipeline {

    agent any

    parameters {
        choice(
            name: 'BROWSER',
            choices: ['CHROME', 'FIREFOX', 'EDGE'],
            description: 'Select browser for automation testing'
        )
    }

    stages {

        stage('0 - Notify Build Start') {
            steps {
                slackSend(
                    channel: '#all-rita-demo',
                    color: '#439FE0',
                    message: "🚀 Build #${BUILD_NUMBER} started - Browser: ${params.BROWSER}"
                )
            }
        }

        stage('1 - Get Code') {
            steps {
                checkout scm
            }
        }

        stage('2 - Compiler') {
            steps {
                bat 'mvn clean'
            }
        }

        stage('3 - Prepare Environment') {
            steps {

                withCredentials([
                    file(
                        credentialsId: 'env-dev-properties',
                        variable: 'ENV_FILE'
                    )
                ]) {

                    bat '''
                        if not exist environmentConfig mkdir environmentConfig

                        copy /Y "%ENV_FILE%" "environmentConfig\\env-dev.properties"

                        echo Environment configuration prepared.
                    '''
                }
            }
        }

        stage('4 - Run Test') {
            steps {

                echo "Selected Browser: ${params.BROWSER}"

                bat """
                    echo Selected Browser: ${params.BROWSER}
                    mvn test -DBROWSER=${params.BROWSER}
                """
            }
        }

        stage('5 - Public Report') {
            steps {
                script {
                    echo 'Generating test report...'
                }
            }
        }

        stage('6 - Publish Test Result') {
            steps {

                junit(
                    testResults: 'target/surefire-reports/*.xml',
                    allowEmptyResults: true
                )

                archiveArtifacts(
                    artifacts: 'target/surefire-reports/**/*',
                    allowEmptyArchive: true
                )
            }
        }
    }

    post {

        always {
            echo "Build #${BUILD_NUMBER} finished."
        }

        success {
            slackSend(
                channel: '#all-rita-demo',
                color: 'good',
                message: "✅ Build #${BUILD_NUMBER} SUCCESS - Browser: ${params.BROWSER}"
            )
        }

        failure {
            slackSend(
                channel: '#all-rita-demo',
                color: 'danger',
                message: "❌ Build #${BUILD_NUMBER} FAILED - Browser: ${params.BROWSER}"
            )
        }
    }
}