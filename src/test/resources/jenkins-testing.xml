<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Automation Testing" parallel="tests" thread-count="2">

    <test name="Jenkins Tests">
        <parameter name="browser" value="chrome"/>

        <groups>
            <run>
                <include name="jenkins"/>
            </run>
        </groups>

        <packages>
            <package name="com.nopcommerce.testcases.user"/>
        </packages>
    </test>


</suite>
