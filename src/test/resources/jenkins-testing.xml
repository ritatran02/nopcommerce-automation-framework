<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Jenkins UI Automation">

    <parameter name="server" value="env-dev"/>

    <test name="Jenkins Tests">
        <parameter name="browser" value="chrome"/>

        <groups>
            <run>
                <include name="jenkins"/>
            </run>
        </groups>

        <packages>
            <package name="com.nopcommerce.testcases.user"/>
        </packages>
    </test>

</suite>